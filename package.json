{
  "name": "thaniumnine-data-api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API starter for PostgreSQL JSONB topic events and native SQL table topics.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {

    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",

    "db:migrate": "tsx scripts/migrate.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:org-admin": "tsx scripts/seed-admin.ts --organisation",
    "hash:password": "tsx scripts/hash-password.ts",
    "iterate:deviceType": "tsx scripts/iterate-types-json-into-table-deviceType.ts",
    "insert-new:organisation": "tsx scripts/insert-new-organisation.ts",
    "create_new_aggregation_record_tables" : "tsx scripts/create_new_aggregation_record_tables.ts",
  
    "test": "jest",
    "test:e2e": "jest --config ./tests/jest-e2e.config.json",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e:cov": "jest --config ./tests/jest-e2e.config.json --coverage",
    "test:all:cov": "jest --coverage --runInBand && jest --config ./tests/jest-e2e.config.json --coverage  --runInBand",
    "test:schedules": "jest --config ./tests/jest-e2e.config.json --runInBand scheduleEntries",
    "test:schedules:cov": "jest --config ./tests/jest-e2e.config.json --coverage --runInBand scheduleEntries",

    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\""
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.2",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.18",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.18",
    "dotenv": "^16.4.7",
    "kysely": "^0.28.16",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.25",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  }
}
